GATEWAY_AUTH_MODE=single_token       # "single_token" or "redis_gateways"
XRPL_RPC_URL=https://s1.ripple.com:51234
MY_DESTINATION_ADDRESS=rYourXRPLReceivingAddressHere1234567890...
FACILITATOR_BEARER_TOKEN=replace-with-a-random-shared-secret
REDIS_URL=redis://127.0.0.1:6379/0   # use redis://redis:6379/0 in Docker Compose
NETWORK_ID=xrpl:0                    # xrpl:0 = mainnet, xrpl:1 = testnet
XRPL_NETWORK=xrpl:0                  # buyer-side network for examples; set to xrpl:1 for Testnet
VALIDATION_TIMEOUT=15
MAX_FEE_DROPS=1000                  # maximum transaction fee accepted by the facilitator
MIN_XRP_DROPS=1000                  # 0.001 XRP minimum
ALLOWED_ISSUED_ASSETS=              # explicit CODE:ISSUER allowlist for USDC/custom IOUs; RLUSD is built in
ENABLE_API_DOCS=false               # set true only for local dev or trusted internal access
ENABLE_BAZAAR=true                  # index valid discovery extensions in Redis
DISCOVERY_RETENTION_SECONDS=604800 # Bazaar catalog retention
FACILITATOR_PORT=8000               # optional host port override for the facilitator Docker service
MERCHANT_PORT=8010                  # optional host port override for the merchant Docker service
MAX_REQUEST_BODY_BYTES=32768        # reject oversized payment requests before route handling
REPLAY_PROCESSED_TTL_SECONDS=604800 # 7 days of Redis replay markers
XRPL_WALLET_SEED=                   # buyer wallet seed for examples and Docker Compose demos
XRPL_X402_RECEIPTS_PATH=           # optional local receipt store override for xrpl-x402 payer
PRICE_DROPS=1000                    # XRP price for the merchant example
PRICE_ASSET_CODE=XRP                # set to RLUSD or USDC for issued-asset demos
PRICE_ASSET_ISSUER=                 # issuer for issued-asset demos
PRICE_ASSET_AMOUNT=                 # issued-asset amount for merchant pricing
PAYMENT_ASSET=XRP                   # explicit buyer opt-in; omit for default RLUSD selection
PAYMENT_ASSET_ISSUER=               # required for explicit IOUs such as RLUSD or USDC
PAYMENT_MAX_SPEND=1000              # required cap in the asset's wire unit (drops for XRP)
